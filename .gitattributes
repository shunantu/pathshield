# 默认按文本处理，但仓库内统一存 LF
* text=auto eol=lf

# shell 脚本必须 LF —— CRLF 会让设备上的 sh 报 "not found"
*.sh        text eol=lf
*.ps1       text eol=crlf

# 内核源码
*.c          text eol=lf
*.h          text eol=lf
Kbuild       text eol=lf
Makefile     text eol=lf

# 前端
*.html       text eol=lf
*.js         text eol=lf
*.css        text eol=lf

# 文档
*.md         text eol=lf

# 二进制
*.ko         binary
*.zip        binary
*.png        binary
